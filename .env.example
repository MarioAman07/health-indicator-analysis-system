# Copy this file to .env and adjust the values for your machine.
# .env is ignored by Git. Never put real credentials or patient data here.

# Folder with the unpacked PhysioNet 2019 training files (training_setA/, training_setB/)
DATA_DIR=./data/raw

# Folder for intermediate, derived data
PROCESSED_DIR=./data/processed

# Trained model artifact and its metadata
MODEL_PATH=./models/model.joblib
MODEL_METADATA_PATH=./models/model_metadata.json

# Application database (demo patients, stored predictions, model versions)
DATABASE_URL=sqlite:///./app.db

# Backend address used by the dashboard
API_BASE_URL=http://localhost:8000

# Random seed used by data splits and model training
RANDOM_SEED=42
