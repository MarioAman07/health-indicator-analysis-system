@startuml component
' Component diagram (draft) — DIP-13, updated in DIP-27 (data-source adapter, hourly cycle, alert acknowledgement)
' Source of diagrams/export/component.png
' Layers top to bottom: dashboard -> API -> core -> storage; the hourly cycle and the offline pipeline reuse the core.
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam nodesep 40
skinparam ranksep 60
skinparam ArrowColor #555555
skinparam package {
  BorderColor #555555
  FontStyle bold
}

title Components (draft): Health Indicator Analysis System

package "Dashboard (Streamlit)" as UI {
  [Patient list view] as V1
  [Patient detail view\n(alerts, reasons,\nacknowledgement)] as V2
  [Model comparison view] as V3
}

package "Backend API (FastAPI)" as API {
  [Patients router\n/api/v1/patients] as R1
  [Prediction router\n/api/v1/predict] as R2
  [Alerts router\n/api/v1/alerts] as R4
  [Models router\n/api/v1/models] as R3
}

package "Hourly cycle" as RUN {
  [Scheduler] as SCH
  [Data-source interface] as DSI
  [Replay adapter\n(diploma)] as RA
  [MIS adapter\n(target, not built)] as MA #EEEEEE
}

package "Offline pipeline (CLI / Makefile)" as OFF {
  [Ingestion] as ING
  [Training] as TR
  [Evaluation] as EV
}

package "Core (Python package src/ml)" as CORE {
  [Data validation] as VAL
  [Feature builder\n(same code for training\nand inference)] as FB
  [Inference service] as INF
  [Alert logic\n(threshold, suppression,\nre-alert, insufficient data)] as AL
  [Explanation (SHAP)] as EXP
}

database "SQLite\npatients, predictions, alerts,\nacknowledgements, audit,\nmodel versions" as DB
folder "Model store\nmodel file + metadata" as MS
folder "Dataset files\ndata/raw (not in Git)" as DS
folder "Evaluation reports" as REP

V1 --> R1 : HTTP/JSON
V2 --> R1 : HTTP/JSON
V2 --> R4 : acknowledge
V3 --> R3 : HTTP/JSON

R1 --> DB
R2 --> INF
R2 --> DB : store prediction
R4 --> DB : store acknowledgement
R3 --> MS
R3 --> REP : read

SCH --> DSI : new values for hour t
RA ..> DSI : implements
MA ..> DSI : implements
RA --> DS : read
SCH --> VAL
SCH --> INF : run hourly
INF --> DB : store prediction, alert

INF --> FB
INF --> AL
INF --> EXP
INF --> MS : load model

ING --> VAL
ING --> DS : read
TR --> FB
TR --> MS : save model
EV --> INF
EV --> REP : write

UI -[hidden]right-> OFF
@enduml
